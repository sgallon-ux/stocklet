rules_version = '2';

// Reglas de Cloud Storage para Stocklet.
//
// Rutas que usa la app (lib/datos_app.dart):
//   usuarios/{uid}/foto_perfil                  -> foto de perfil
//   negocios/{negocioId}/logo/imagen            -> logo del negocio
//   negocios/{negocioId}/catalogos/{archivo}    -> catálogos en PDF
//
// La pertenencia al negocio se consulta en Firestore, que es donde vive.

service firebase.storage {
  match /b/{bucket}/o {

    function autenticado() {
      return request.auth != null;
    }

    function miFicha() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }

    function tengoFicha() {
      return autenticado() &&
             firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid));
    }

    function esMiembro(negocioId) {
      return tengoFicha() && miFicha().get('negocioId', '') == negocioId;
    }

    function esDuenoOSocio(negocioId) {
      return esMiembro(negocioId) && miFicha().get('rol', 'empleado') in ['dueno', 'socio'];
    }

    function esImagen() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 5 * 1024 * 1024;
    }

    function esPdf() {
      return request.resource.contentType == 'application/pdf' &&
             request.resource.size < 20 * 1024 * 1024;
    }

    // Foto de perfil: la gestiona su dueño. La leen los miembros del negocio
    // (la pantalla de miembros muestra las fotos).
    match /usuarios/{uid}/{archivo=**} {
      allow read: if autenticado();
      allow write: if autenticado() && request.auth.uid == uid && esImagen();
      allow delete: if autenticado() && request.auth.uid == uid;
    }

    // Logo del negocio: lo ven todos los miembros, lo cambian dueño y socio.
    match /negocios/{negocioId}/logo/{archivo=**} {
      allow read: if esMiembro(negocioId);
      allow write: if esDuenoOSocio(negocioId) && esImagen();
      allow delete: if esDuenoOSocio(negocioId);
    }

    // Catálogos en PDF: los ven todos los miembros, los suben dueño y socio.
    match /negocios/{negocioId}/catalogos/{archivo=**} {
      allow read: if esMiembro(negocioId);
      allow write: if esDuenoOSocio(negocioId) && esPdf();
      allow delete: if esDuenoOSocio(negocioId);
    }

    // Todo lo demás, cerrado.
    match /{rutaCualquiera=**} {
      allow read, write: if false;
    }
  }
}
